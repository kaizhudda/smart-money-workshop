---
import fs from 'node:fs';
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
import StickyCta from '../components/StickyCta.astro';
import Todo from '../components/Todo.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
import { site } from '../data/program';
import {
  offer,
  proof,
  weeks,
  valueStack,
  valueStackTotal,
  freePacksValue,
  guarantee,
  testimonials,
  faqs,
} from '../data/program';

const isTodo = (v: unknown) => typeof v === 'string' && v.startsWith('TODO');

// Show the real founder photo the moment the file exists, and keep the
// placeholder visible until then — so a missing image is never a broken one.
const photoFile = new URL('../../public/kaiz.jpg', import.meta.url);
const hasPhoto = fs.existsSync(photoFile);

// Keep the testimonial grid looking deliberate whether there are two quotes
// or three — adding a real third one needs no layout change.
const testimonialCols =
  testimonials.length >= 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2';
---

<Layout showHeader={false}>
  {/* ==================================================================
      HERO — must be able to close on its own. Everything below this
      exists only for people who need more before they'll act.
  ================================================================== */}
  <section
    class="relative overflow-hidden bg-gradient-to-b from-gold-400 via-gold-300 to-cream-100"
  >
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.18]"
      style="background-image: radial-gradient(circle at 1px 1px, #7a3e12 1px, transparent 0); background-size: 28px 28px;"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-4xl px-5 pt-6 pb-12 text-center sm:px-8 sm:pt-8 sm:pb-20">
      {/* Brand sits inside the hero rather than in a header bar, so it costs
          almost no height above the hook. */}
      <p
        class="mb-6 inline-flex items-center gap-2 font-display text-sm font-bold text-cocoa sm:text-base"
      >
        <span
          class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-cream-50/70 text-cocoa shadow-sm"
        >
          <Icon name="coin" class="h-4 w-4" />
        </span>
        {site.name}
      </p>

      <p
        class="mb-5 block rounded-full text-xs font-bold tracking-widest text-cocoa uppercase sm:text-sm"
      >
        Live on {offer.platform} · Ages {offer.ageRange}
      </p>

      <h1 class="font-display text-4xl leading-[1.05] font-extrabold tracking-tight sm:text-6xl">
        School will teach your child algebra.
        <span class="block text-cocoa">It won’t teach them money.</span>
      </h1>

      <p
        class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-700 sm:text-xl"
      >
        A live {offer.sessionCount}-week class that teaches kids to budget, save,
        spend smart, and earn their own first $5. Small groups, real discussion.
      </p>

      <div id="hero-cta" class="mt-8">
        <Cta />
      </div>

      <dl
        class="mx-auto mt-10 grid max-w-2xl grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4"
      >
        {
          [
            { n: offer.sessionCount, l: 'live sessions', c: 'bg-flame-500' },
            { n: `${offer.sessionMinutes} min`, l: 'each week', c: 'bg-mint-brand' },
            { n: offer.ageRange, l: 'years old', c: 'bg-sky-brand' },
            { n: offer.platformShort, l: 'from home', c: 'bg-gold-500' },
          ].map((s) => (
            <div class="overflow-hidden rounded-xl bg-cream-50 shadow-md ring-1 ring-ink-900/5">
              <div class={`h-1 ${s.c}`} aria-hidden="true" />
              <div class="px-3 py-3">
                <dt class="font-display text-xl font-bold text-ink-900 sm:text-2xl">
                  {s.n}
                </dt>
                <dd class="mt-0.5 text-xs text-ink-500">{s.l}</dd>
              </div>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ==================================================================
      DREAM OUTCOME — the single highest-value block on the page.
      One line of framing, then straight to what the child can do.
  ================================================================== */}
  {/* A tinted, full-bleed band with a hairline top edge — the hero's
      gradient fades to the exact same cream as the page background, so
      without this the two sections ran together with no visible seam. */}
  <section class="border-t border-cream-300/70 bg-cream-200/50 py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <div class="max-w-2xl">
        <h2 class="font-display text-2xl font-bold sm:text-4xl">
          After four weeks, your child can do these four things.
        </h2>
        <p class="mt-3 text-ink-500 sm:text-lg">
          Not “understands the importance of saving”. Actually does them.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          weeks.map((w) => (
            <div class="flex gap-3.5 rounded-2xl bg-cream-50 p-5 shadow-sm ring-1 ring-ink-900/5">
              <span
                class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-mint-brand/15 text-sm font-bold text-mint-brand"
                aria-hidden="true"
              >
                ✓
              </span>
              <p class="leading-relaxed font-medium text-ink-900">
                {w.outcome}
              </p>
            </div>
          ))
        }
      </div>

      {/* Curriculum detail lives here, collapsed. Available to the parent
          who wants it, invisible to the one who's already convinced. */}
      <details class="group mt-6">
        <summary
          class="flex cursor-pointer list-none items-center justify-center gap-2 rounded-full bg-cream-50 px-5 py-3 text-sm font-bold text-ink-900 shadow-sm transition hover:bg-cream-100 [&::-webkit-details-marker]:hidden"
        >
          <span class="group-open:hidden">See what happens in each session</span>
          <span class="hidden group-open:inline">Hide session details</span>
          <span
            class="text-flame-500 transition-transform group-open:rotate-180"
            aria-hidden="true">▾</span
          >
        </summary>

        <div class="mt-4 space-y-3">
          {
            weeks.map((w) => (
              <div class="rounded-2xl bg-cream-50 p-5 shadow-sm ring-1 ring-ink-900/5">
                <div class="flex items-baseline gap-3">
                  <span class="font-display text-sm font-bold text-flame-500">
                    Week {w.number}
                  </span>
                  <h3 class="font-display text-lg font-bold">{w.title}</h3>
                </div>
                <p class="mt-1 text-sm text-ink-500 italic">{w.hook}</p>
                <ul class="mt-3 grid gap-1.5 sm:grid-cols-2">
                  {w.covers.map((c) => (
                    <li class="flex gap-2 text-sm text-ink-700">
                      <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-flame-500" />
                      <span>{c}</span>
                    </li>
                  ))}
                </ul>
                <p class="mt-3 text-sm text-ink-500">
                  <span class="font-semibold text-ink-900">Takes home:</span>
                  {' '}
                  {w.takeaway}
                </p>
              </div>
            ))
          }
          <p class="px-1 text-sm text-ink-500">
            Every session is recorded, so a missed week is never a lost week.
          </p>
        </div>
      </details>
    </div>
  </section>

  {/* ==================================================================
      THE OFFER — value stack, price and risk reversal in one block.
      The guarantee sits directly under the price where it works hardest.
  ================================================================== */}
  <section class="bg-ink-900 py-14 text-cream-100 sm:py-20">
    <div class="mx-auto max-w-2xl px-5 sm:px-8">
      <h2 class="font-display text-2xl font-bold text-cream-100 sm:text-4xl">
        Everything they get
      </h2>

      <ul class="mt-8 space-y-2.5">
        {
          valueStack.map((v) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-cream-100/10 pb-2.5">
              <span class="font-medium text-cream-100">{v.item}</span>
              <span class="shrink-0 font-display font-bold text-gold-400">
                ${v.value}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="mt-5 flex items-baseline justify-between gap-4">
        <p class="font-display text-lg font-bold text-cream-100">Total value</p>
        <p class="font-display text-2xl font-bold text-gold-400">
          ${valueStackTotal}
        </p>
      </div>

      <div class="mt-8 rounded-3xl bg-cream-100 p-6 text-center text-ink-700 sm:p-8">
        {/* Real cap, not manufactured urgency — small cohorts are the reason
            the sessions work at all. */}
        <p
          class="mb-3 inline-flex items-center gap-2 rounded-full bg-flame-500/10 px-3.5 py-1.5 text-sm font-bold text-flame-600"
        >
          <span
            class="inline-block h-1.5 w-1.5 rounded-full bg-flame-500"
            aria-hidden="true"></span>
          Only {offer.spotsTotal} spots in this cohort
        </p>

        <p class="text-xs font-bold tracking-widest text-ink-400 uppercase">
          Your price for the next cohort
        </p>

        {
          isTodo(offer.price) ? (
            <div class="mt-3">
              <Todo label="cohort price (AUD)" />
            </div>
          ) : (
            <p class="mt-2 font-display text-5xl font-bold text-ink-900 sm:text-6xl">
              {offer.price}
            </p>
          )
        }

        {
          offer.priceNote && (
            <p class="mt-2 inline-block rounded-full bg-mint-brand/15 px-3 py-1 text-xs font-bold text-mint-700">
              {offer.priceNote}
            </p>
          )
        }

        <p class="mt-3 text-sm text-ink-500">
          One payment, per child. Nothing ongoing.
        </p>

        {/* Risk reversal, kept compact so it supports the price instead of
            competing with it for space. Full terms live in the FAQ. */}
        <p class="mx-auto mt-4 flex max-w-[15rem] items-start justify-center gap-1.5 text-sm font-semibold text-ink-700 sm:max-w-none">
          <Icon name="shield" class="mt-0.5 h-4 w-4 shrink-0 text-flame-600" />
          <span>{guarantee.short}</span>
        </p>

        <div class="mt-6">
          <Cta />
        </div>
      </div>
    </div>
  </section>

  {/* ==================================================================
      PROOF — testimonials and founder credibility, compressed.
  ================================================================== */}
  <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
    <h2 class="font-display text-2xl font-bold sm:text-4xl">
      It’s already run. Here’s how it went.
    </h2>
    <p class="mt-3 text-ink-500 sm:text-lg">
      A free pilot cohort of {proof.pilotStudents} students, followed by a first
      paid cohort of {proof.firstPaidCohortStudents}.
    </p>

    <div class={`mt-8 grid gap-4 ${testimonialCols}`}>
      {
        testimonials.map((t) => (
          <figure class="flex flex-col rounded-2xl bg-cream-50 p-6 shadow-sm ring-1 ring-ink-900/5">
            {t.isPlaceholder && <Todo label="real pilot testimonial" />}
            <span class="font-display text-3xl leading-none text-gold-500" aria-hidden="true">
              “
            </span>
            <blockquote class="mt-1 flex-1 leading-relaxed text-ink-700">
              {t.quote}
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-3 border-t border-cream-300 pt-4">
              <span
                class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-gold-400 font-display text-sm font-bold text-cocoa"
                aria-hidden="true"
              >
                {t.author.charAt(0)}
              </span>
              <span class="text-sm">
                <span class="block font-bold text-ink-900">{t.author}</span>
                <span class="block text-ink-400">{t.context}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    {/* Founder — trimmed to what actually builds trust, nothing more */}
    <div
      class="mt-10 flex flex-col gap-5 rounded-3xl bg-cream-200/70 p-6 sm:flex-row sm:items-center sm:p-8"
    >
      <div class="shrink-0">
        {
          hasPhoto ? (
            <img
              src={url('/kaiz.jpg')}
              alt="Kaiz Hudda"
              width="96"
              height="96"
              loading="lazy"
              class="h-24 w-24 rounded-2xl object-cover shadow-md ring-1 ring-ink-900/10"
            />
          ) : (
            <div class="grid h-20 w-20 place-items-center rounded-2xl border-2 border-dashed border-flame-500 bg-flame-500/10 text-center text-[0.55rem] leading-tight font-bold tracking-wide text-flame-600 uppercase">
              ⚠ Save photo to
              <br />
              public/kaiz.jpg
            </div>
          )
        }
      </div>

      <div class="min-w-0">
        <h3 class="font-display text-xl font-bold">Taught by Kaiz Hudda</h3>
        <p class="mt-2 leading-relaxed text-ink-700">
          I hosted a {proof.podcastEpisodes}-episode podcast on money, taught
          crypto to everyday people, and built my own home and businesses from
          scratch. Nobody taught me any of it. I worked it out the expensive
          way. This is the class I wish I’d had.
        </p>
        <a
          href={proof.podcastUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 -mx-1 inline-flex items-center gap-2 rounded-lg px-1 py-2.5 text-sm font-semibold text-flame-600"
        >
          <Icon name="headphones" class="h-4 w-4 shrink-0" />
          <span class="underline decoration-2 underline-offset-4">
            Listen: “{proof.podcastTitle}”
          </span>
        </a>
      </div>
    </div>
  </section>

  {/* ==================================================================
      OBJECTIONS — collapsed, so they cost almost no scroll.
  ================================================================== */}
  <section class="bg-cream-200/60 py-14 sm:py-20">
    <div class="mx-auto max-w-2xl px-5 sm:px-8">
      <h2 class="font-display text-2xl font-bold sm:text-4xl">
        Questions parents ask
      </h2>

      <div class="mt-6 space-y-2">
        {
          faqs.map((f) => (
            <details class="group rounded-xl bg-cream-50 shadow-sm ring-1 ring-ink-900/5 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 text-sm font-bold text-ink-900 sm:text-base">
                {f.q}
                <span
                  class="shrink-0 text-lg text-flame-500 transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="px-4 pb-4 text-sm leading-relaxed text-ink-700">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ==================================================================
      CLOSE
  ================================================================== */}
  <section class="bg-gradient-to-b from-cream-100 to-gold-300 py-14 sm:py-20">
    <div class="mx-auto max-w-xl px-5 text-center sm:px-8">
      <h2 class="font-display text-2xl font-bold sm:text-4xl">
        Four weeks. One habit that lasts.
      </h2>
      <p class="mt-4 leading-relaxed text-ink-700">
        There are {offer.spotsTotal} spots in this cohort. Registering costs
        nothing and commits you to nothing. It puts your child’s name down, then
        I get in touch personally to talk it through and let you know if one of
        them is yours. Either way you keep three packs worth ${freePacksValue}.
      </p>
      <div class="mt-7">
        <Cta />
      </div>
    </div>
  </section>

  <StickyCta />
</Layout>
