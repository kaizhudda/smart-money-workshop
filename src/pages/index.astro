---
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
import Todo from '../components/Todo.astro';
import {
  offer,
  proof,
  weeks,
  valueStack,
  valueStackTotal,
  guarantee,
  testimonials,
  faqs,
} from '../data/program';

const isTodo = (v: unknown) => typeof v === 'string' && v.startsWith('TODO');
---

<Layout>
  {/* ==================================================================
      HERO — the hook
  ================================================================== */}
  <section
    class="relative overflow-hidden bg-gradient-to-b from-gold-400 via-gold-300 to-cream-100"
  >
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.18]"
      style="background-image: radial-gradient(circle at 1px 1px, #7a3e12 1px, transparent 0); background-size: 28px 28px;"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-4xl px-5 py-16 text-center sm:px-8 sm:py-24">
      <p
        class="mb-6 inline-block rounded-full bg-ink-900/10 px-4 py-1.5 text-sm font-bold tracking-wide text-cocoa uppercase"
      >
        Live on Zoom · Ages {offer.ageRange}
      </p>

      <h1 class="font-display text-4xl leading-[1.1] font-bold sm:text-6xl">
        School will teach your child algebra.
        <span class="block text-cocoa">It won’t teach them money.</span>
      </h1>

      <p
        class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-700 sm:text-xl"
      >
        Smart Money Workshop is a live {offer.sessionCount}-week class that
        teaches kids how money actually works — budgeting, saving, spending
        smart, and earning their own first $5. Small groups, real discussion,
        taught by a real person. Not a video course they’ll never finish.
      </p>

      <div class="mt-10">
        <Cta />
      </div>

      <dl
        class="mx-auto mt-14 grid max-w-2xl grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-6"
      >
        {
          [
            { n: offer.sessionCount, l: 'live sessions' },
            { n: `${offer.sessionMinutes} min`, l: 'each week' },
            { n: offer.ageRange, l: 'years old' },
            { n: 'Zoom', l: 'from home' },
          ].map((s) => (
            <div class="rounded-2xl bg-cream-50/70 px-3 py-4 shadow-sm ring-1 ring-ink-900/5">
              <dt class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">
                {s.n}
              </dt>
              <dd class="mt-0.5 text-xs text-ink-500 sm:text-sm">{s.l}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ==================================================================
      THE PROBLEM
  ================================================================== */}
  <section class="mx-auto max-w-3xl px-5 py-20 sm:px-8 sm:py-28">
    <h2 class="font-display text-3xl font-bold sm:text-4xl">
      Most of us learned about money the expensive way.
    </h2>

    <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink-700">
      <p>
        By the time anyone explains a budget, an interest rate, or why the thing
        in the cart isn’t worth it — the lesson has usually already cost
        something. A first pay cheque that vanished. A credit card that seemed
        free. Years of not quite knowing where the money went.
      </p>
      <p>
        Meanwhile your child is already making money decisions. Skins, in-app
        purchases, the thing their friend has, whatever the allowance goes on
        this week. They’re building habits right now, with or without anyone
        teaching them.
      </p>
      <p class="font-semibold text-ink-900">
        Those habits are much easier to build at 10 than to fix at 30.
      </p>
    </div>
  </section>

  {/* ==================================================================
      WHAT THEY WALK AWAY WITH
  ================================================================== */}
  <section class="bg-cream-200/60 py-20 sm:py-28">
    <div class="mx-auto max-w-5xl px-5 sm:px-8">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-bold sm:text-4xl">
          After four weeks, your child can do these four things.
        </h2>
        <p class="mt-4 text-lg text-ink-500">
          Not “understands the importance of saving”. Actually does them.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {
          weeks.map((w) => (
            <div class="rounded-2xl bg-cream-50 p-6 shadow-sm ring-1 ring-ink-900/5">
              <span
                class="grid h-10 w-10 place-items-center rounded-xl bg-mint-brand/15 font-display text-lg font-bold text-mint-brand"
                aria-hidden="true"
              >
                ✓
              </span>
              <p class="mt-4 leading-relaxed font-medium text-ink-900">
                {w.outcome}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ==================================================================
      CURRICULUM — week by week
  ================================================================== */}
  <section class="mx-auto max-w-5xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">
        What happens in each session
      </h2>
      <p class="mt-4 text-lg text-ink-500">
        One {offer.sessionMinutes}-minute session a week, live on {
          offer.platform
        }. Cameras on, small group, lots of talking. Every session is recorded in
        case you miss one.
      </p>
    </div>

    <ol class="mt-12 space-y-5">
      {
        weeks.map((w) => (
          <li class="overflow-hidden rounded-2xl bg-cream-50 shadow-sm ring-1 ring-ink-900/5">
            <div class="flex flex-col gap-6 p-6 sm:flex-row sm:p-8">
              <div class="shrink-0">
                <div class="grid h-14 w-14 place-items-center rounded-2xl bg-gold-400 shadow-sm">
                  <span class="font-display text-2xl font-bold text-cocoa">
                    {w.number}
                  </span>
                </div>
              </div>

              <div class="min-w-0 flex-1">
                <p class="text-xs font-bold tracking-widest text-ink-400 uppercase">
                  Week {w.number}
                </p>
                <h3 class="mt-1 font-display text-2xl font-bold">{w.title}</h3>
                <p class="mt-1.5 text-lg text-ink-500 italic">{w.hook}</p>

                <ul class="mt-5 grid gap-2.5 sm:grid-cols-2">
                  {w.covers.map((c) => (
                    <li class="flex gap-2.5 text-ink-700">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-flame-500" />
                      <span>{c}</span>
                    </li>
                  ))}
                </ul>

                <p class="mt-5 rounded-xl bg-cream-200/70 px-4 py-3 text-sm text-ink-700">
                  <span class="font-bold text-ink-900">They take home:</span>{' '}
                  {w.takeaway}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ==================================================================
      VALUE STACK + PRICE
  ================================================================== */}
  <section class="bg-ink-900 py-20 text-cream-100 sm:py-28">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-bold text-cream-100 sm:text-4xl">
        Everything included
      </h2>
      <p class="mt-4 text-lg text-cream-300">
        The sessions are the smallest part of it. The materials are what keep it
        going after the Zoom call ends.
      </p>

      <ul class="mt-12 divide-y divide-cream-100/10">
        {
          valueStack.map((v) => (
            <li class="flex items-start justify-between gap-6 py-5">
              <div class="min-w-0">
                <p class="font-bold text-cream-100">{v.item}</p>
                <p class="mt-1 text-sm leading-relaxed text-cream-300/80">
                  {v.detail}
                </p>
              </div>
              <p class="shrink-0 pt-0.5 font-display text-lg font-bold text-gold-400">
                ${v.value}
              </p>
            </li>
          ))
        }
      </ul>

      <div
        class="mt-8 flex items-baseline justify-between gap-6 border-t-2 border-gold-400/40 pt-6"
      >
        <p class="font-display text-xl font-bold text-cream-100">Total value</p>
        <p class="font-display text-3xl font-bold text-gold-400">
          ${valueStackTotal}
        </p>
      </div>

      <div
        class="mt-12 rounded-3xl bg-cream-100 p-8 text-center text-ink-700 sm:p-10"
      >
        <p class="text-sm font-bold tracking-widest text-ink-400 uppercase">
          Your price for the next cohort
        </p>

        {
          isTodo(offer.price) ? (
            <div class="mt-4">
              <Todo label="cohort price (AUD)" />
            </div>
          ) : (
            <p class="mt-3 font-display text-6xl font-bold text-ink-900">
              {offer.price}
            </p>
          )
        }

        <p class="mt-4 text-ink-500">
          One payment, per child. Nothing ongoing, nothing to cancel.
        </p>

        <div class="mt-8">
          <Cta />
        </div>
      </div>
    </div>
  </section>

  {/* ==================================================================
      GUARANTEE
  ================================================================== */}
  <section class="mx-auto max-w-3xl px-5 py-20 sm:px-8 sm:py-28">
    <div
      class="rounded-3xl border-2 border-dashed border-gold-500 bg-gold-400/10 p-8 text-center sm:p-12"
    >
      <span class="text-5xl" aria-hidden="true">🛡️</span>
      <h2 class="mt-5 font-display text-2xl font-bold sm:text-3xl">
        {guarantee.headline}
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-ink-700">
        {guarantee.body}
      </p>
    </div>
  </section>

  {/* ==================================================================
      FOUNDER
  ================================================================== */}
  <section class="bg-cream-200/60 py-20 sm:py-28">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
        <div class="shrink-0">
          {/* TODO: replace with a real photo of Kaiz — see README */}
          <div
            class="grid h-28 w-28 place-items-center rounded-3xl border-2 border-dashed border-flame-500 bg-flame-500/10 text-center text-[0.6rem] leading-tight font-bold tracking-wide text-flame-600 uppercase"
          >
            ⚠ Photo<br />of Kaiz
          </div>
        </div>

        <div>
          <h2 class="font-display text-3xl font-bold sm:text-4xl">
            Why I built this
          </h2>
          <div class="mt-5 space-y-4 text-lg leading-relaxed text-ink-700">
            <p>
              I’m Kaiz. Growing up, I got almost no financial education. I worked
              it out through trial and error — some of which was expensive, all
              of which took longer than it needed to.
            </p>
            <p>
              Since then I’ve hosted a {proof.podcastEpisodes}-episode podcast
              about money, run webinars teaching cryptocurrency to everyday
              people, bought and built my own home from scratch, and built
              businesses in tech and retail.
            </p>
            <p>
              None of that is the point. The point is that every bit of it would
              have been easier if someone had sat me down as a kid and explained
              the basics. That’s the whole reason this workshop exists — it’s the
              class I wish I’d had.
            </p>
          </div>

          <a
            href={proof.podcastUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2.5 rounded-full bg-ink-900 px-5 py-3 text-sm font-semibold text-cream-100 transition hover:bg-cocoa"
          >
            <span aria-hidden="true">🎧</span>
            Listen: “{proof.podcastTitle}”
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ==================================================================
      PROOF / TESTIMONIALS
  ================================================================== */}
  <section class="mx-auto max-w-5xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">
        It’s already run — here’s how it went
      </h2>
      <p class="mt-4 text-lg text-ink-500">
        A free pilot cohort of {proof.pilotStudents} students, followed by a first
        paid cohort of {proof.firstPaidCohortStudents}.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-3">
      {
        testimonials.map((t) => (
          <figure class="flex flex-col rounded-2xl bg-cream-50 p-6 shadow-sm ring-1 ring-ink-900/5">
            {t.isPlaceholder && <Todo label="real pilot testimonial" />}
            <blockquote class="flex-1 leading-relaxed text-ink-700">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-5 border-t border-cream-300 pt-4 text-sm">
              <span class="font-bold text-ink-900">{t.author}</span>
              <span class="block text-ink-400">{t.context}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {/* ==================================================================
      FAQ
  ================================================================== */}
  <section class="bg-cream-200/60 py-20 sm:py-28">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">
        Questions parents ask
      </h2>

      <div class="mt-10 space-y-3">
        {
          faqs.map((f) => (
            <details class="group rounded-2xl bg-cream-50 shadow-sm ring-1 ring-ink-900/5 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-bold text-ink-900 sm:p-6">
                {f.q}
                <span
                  class="shrink-0 text-xl text-flame-500 transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="px-5 pb-5 leading-relaxed text-ink-700 sm:px-6 sm:pb-6">
                {f.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ==================================================================
      CLOSE
  ================================================================== */}
  <section class="bg-gradient-to-b from-cream-100 to-gold-300 py-20 sm:py-28">
    <div class="mx-auto max-w-2xl px-5 text-center sm:px-8">
      <h2 class="font-display text-3xl font-bold sm:text-5xl">
        Four weeks. One habit that lasts.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-700">
        Registering is free and takes about a minute. You’ll get the full
        materials pack either way — and I’ll email you personally to let you know
        whether there’s a place in the next cohort.
      </p>
      <div class="mt-10">
        <Cta />
      </div>
    </div>
  </section>
</Layout>
