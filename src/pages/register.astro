---
import Layout from '../layouts/Layout.astro';
import Todo from '../components/Todo.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
import { site, offer, freePacks, freePacksValue, guarantee } from '../data/program';

const isTodo = (v: unknown) => typeof v === 'string' && v.startsWith('TODO');
const hasEmbed = !isTodo(offer.formEmbedUrl);
---

<Layout
  showHeader={false}
  title="Register your child | Smart Money Workshop"
  description="Register your child for the next Smart Money Workshop cohort. Registering is free, the workshop itself isn't: no payment now, and no guaranteed spot until Kaiz follows up personally."
>
  <section class="bg-gradient-to-b from-gold-400 to-cream-100 px-5 pt-6 pb-8 text-center sm:px-8 sm:pt-8 sm:pb-10">
    <div class="mx-auto max-w-2xl">
      {/* Brand lives in the hero, not a separate header bar, matching the
          home page. Still links back, since this page benefits from an
          escape hatch the home page doesn't need. */}
      <a
        href={url('/')}
        class="mb-6 inline-flex items-center gap-2 font-display text-sm font-bold text-cocoa sm:text-base"
      >
        <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-cream-50/70 text-cocoa shadow-sm">
          <Icon name="coin" class="h-4 w-4" />
        </span>
        {site.name}
      </a>

      <h1 class="font-display text-3xl font-extrabold tracking-tight sm:text-5xl">
        Register your child
      </h1>
      <p
        class="mt-4 mb-5 inline-flex items-center gap-2 rounded-full bg-flame-500/10 px-3.5 py-1.5 text-sm font-bold text-flame-600"
      >
        <span
          class="inline-block h-1.5 w-1.5 rounded-full bg-flame-500"
          aria-hidden="true"></span>
        Only {offer.spotsTotal} spots in this cohort
      </p>

      <p class="text-lg leading-relaxed text-ink-700">
        This is a registration of interest, not a booking and not a payment. It
        doesn’t hold a spot and it doesn’t commit you to attending. I read every
        registration myself and get in touch to talk it through before anything
        is confirmed.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-5 pt-8 pb-12 sm:px-8 sm:pt-10 sm:pb-16">
    {/* --- Bonuses and risk reversal, condensed to one glance.
        Anyone here already saw the full pitch on the home page and clicked
        through wanting to act — re-running the whole value stack and the
        full guarantee paragraph again is friction, not persuasion, for
        someone already sold. This is a reminder, not a re-sell. --- */}
    <div class="rounded-2xl bg-cream-50 p-5 text-center shadow-sm ring-1 ring-ink-900/5 sm:p-6">
      <p class="font-bold text-mint-700">
        ${freePacksValue} of free materials, yours either way
      </p>
      <p class="mt-1 text-sm text-ink-500">
        {freePacks.map((v) => v.item).join(' · ')}
      </p>
      <p class="mt-4 flex items-center justify-center gap-2 border-t border-cream-300 pt-4 text-sm font-semibold text-ink-700">
        <Icon name="shield" class="h-4 w-4 shrink-0 text-flame-600" />
        {guarantee.short}
      </p>
    </div>

    {/* --- What happens next: kills the "then what?" hesitation, placed
        right before the thing it's explaining. --- */}
    <ol class="mt-10 mb-10 space-y-4">
      {
        [
          {
            t: 'You fill in the form below',
            d: 'Your name, your child’s first name and age, and how to reach you. About 60 seconds.',
          },
          {
            t: `You get three packs worth $${freePacksValue}, free`,
            d: 'Sent straight after you register, whether or not a spot opens up. They’re yours to keep either way.',
          },
          {
            t: 'I get in touch within 48 hours',
            d: 'I’ll email or call to confirm whether there’s a place in the next cohort, and answer anything you want to ask.',
          },
          {
            t: 'Only then do you pay',
            d: 'If your child has a spot and you’re happy to go ahead, I’ll send an invoice. Bank transfer. Nothing before that.',
          },
        ].map((s, i) => (
          <li class="flex gap-4">
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-gold-400 font-display text-sm font-bold text-cocoa">
              {i + 1}
            </span>
            <div class="min-w-0 pt-0.5">
              <p class="font-bold text-ink-900">{s.t}</p>
              <p class="mt-1 leading-relaxed text-ink-500">{s.d}</p>
            </div>
          </li>
        ))
      }
    </ol>

    {/* --- The form --- */}
    <div class="overflow-hidden rounded-3xl bg-cream-50 shadow-md ring-1 ring-ink-900/5">
      {
        hasEmbed ? (
          <iframe
            src={offer.formEmbedUrl}
            title="Smart Money Workshop registration form"
            width="100%"
            height={offer.formEmbedHeight}
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            loading="lazy"
            class="block w-full"
          >
            Loading the registration form…
          </iframe>
        ) : (
          <div class="p-6 sm:p-8">
            <Todo label="Google Form embed URL, see README step 3" />
            <p class="mt-4 leading-relaxed text-ink-500">
              Once you paste the embed URL into{' '}
              <code class="rounded bg-cream-200 px-1.5 py-0.5 text-sm">
                src/data/program.ts
              </code>
              , your Google Form appears here.
            </p>
          </div>
        )
      }
    </div>

    <p class="mt-5 text-center text-sm text-ink-500">
      Form not loading?{' '}
      <a
        href={offer.formUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-flame-600 underline decoration-2 underline-offset-4"
      >
        Open it in a new tab instead →
      </a>
    </p>
  </section>
</Layout>
