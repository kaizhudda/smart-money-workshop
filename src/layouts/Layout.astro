---
import '../styles/global.css';
import { site } from '../data/program';
import { url } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Hide the sticky header CTA — used on the register page itself. */
  hideHeaderCta?: boolean;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = `A live 4-week online workshop teaching kids aged 9–14 how money really works: budgeting, saving, spending smart, and earning their first money.`,
  hideHeaderCta = false,
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-cream-100"
    >
      Skip to content
    </a>

    <Header hideCta={hideHeaderCta} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
