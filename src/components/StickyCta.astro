---
/**
 * Bottom-anchored CTA that appears once the hero button scrolls out of view.
 * The ask is never more than one tap away, so scroll depth stops costing
 * conversions.
 */
import { url } from '../lib/url';
---

<div
  id="sticky-cta"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-50 translate-y-full border-t border-cream-300 bg-cream-100/95 px-4 py-3 opacity-0 shadow-[0_-4px_20px_rgba(46,31,13,0.10)] backdrop-blur-md transition-all duration-300"
>
  <div class="mx-auto flex max-w-2xl items-center justify-between gap-4">
    <p class="hidden text-sm font-semibold text-ink-900 sm:block">
      Free to register · No payment now
    </p>
    <a
      href={url('/register')}
      class="w-full rounded-full bg-flame-500 px-6 py-3 text-center font-bold text-white transition hover:bg-flame-600 sm:w-auto"
    >
      Register your child →
    </a>
  </div>
</div>

<script>
  const bar = document.getElementById('sticky-cta');
  const trigger = document.getElementById('hero-cta');
  const HIDDEN = ['translate-y-full', 'opacity-0', 'pointer-events-none'];

  if (bar && trigger) {
    const update = () => {
      // Show the bar once the hero's own CTA has scrolled past the top.
      const passed = trigger.getBoundingClientRect().bottom < 0;
      bar.classList.toggle('translate-y-full', !passed);
      bar.classList.toggle('opacity-0', !passed);
      bar.classList.toggle('pointer-events-none', !passed);
    };

    bar.classList.add(...HIDDEN);
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update, { passive: true });
  }
</script>
