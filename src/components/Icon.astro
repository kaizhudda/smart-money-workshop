---
/**
 * A small, fixed set of line icons, all drawn to the same stroke weight and
 * corner style so they read as one system.
 *
 * Deliberately not emoji: an emoji glyph (💰, 🛡️, 🎧) renders as a different
 * picture on every OS and browser, and as a blank box on systems with no
 * emoji font at all. An inline SVG looks identical everywhere, every time.
 */
interface Props {
  name:
    | 'coin'
    | 'shield'
    | 'headphones'
    | 'calendar'
    | 'document'
    | 'compass'
    | 'spark'
    | 'play'
    | 'chat';
  class?: string;
}

const { name, class: className = '' } = Astro.props;

const common = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.75',
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
};
---

{
  name === 'coin' && (
    <svg {...common} class={className} aria-hidden="true">
      <circle cx="12" cy="12" r="8.25" />
      <path d="M12 8.25v7.5M14.25 9.75a2.1 2.1 0 0 0-2.1-1.1c-1.25 0-2.15.62-2.15 1.7 0 1.06.9 1.4 2.15 1.65 1.28.26 2.2.62 2.2 1.7 0 1.1-.95 1.75-2.2 1.75a2.28 2.28 0 0 1-2.25-1.2" />
    </svg>
  )
}
{
  name === 'shield' && (
    <svg {...common} class={className} aria-hidden="true">
      <path d="M12 3.5 5 6v5.2c0 4.2 2.8 7.6 7 8.8 4.2-1.2 7-4.6 7-8.8V6l-7-2.5Z" />
      <path d="M9 12.1 11.1 14.2 15.3 10" />
    </svg>
  )
}
{
  name === 'headphones' && (
    <svg {...common} class={className} aria-hidden="true">
      <path d="M4.5 14.5v-2a7.5 7.5 0 0 1 15 0v2" />
      <rect x="3.25" y="14" width="3.5" height="5.5" rx="1.5" />
      <rect x="17.25" y="14" width="3.5" height="5.5" rx="1.5" />
    </svg>
  )
}
{
  name === 'calendar' && (
    <svg {...common} class={className} aria-hidden="true">
      <rect x="4" y="5.5" width="16" height="14" rx="2.25" />
      <path d="M4 9.75h16M8 3.5v3.5M16 3.5v3.5" />
    </svg>
  )
}
{
  name === 'document' && (
    <svg {...common} class={className} aria-hidden="true">
      <path d="M7 3.5h6.5L18 8v11.5a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z" />
      <path d="M13.5 3.5V8H18" />
      <path d="M9 12.5h6M9 15.75h6" />
    </svg>
  )
}
{
  name === 'compass' && (
    <svg {...common} class={className} aria-hidden="true">
      <circle cx="12" cy="12" r="8.25" />
      <path d="M14.8 9.2 13 13l-3.8 1.8L11 11l3.8-1.8Z" />
    </svg>
  )
}
{
  name === 'spark' && (
    <svg {...common} class={className} aria-hidden="true">
      <path d="M11.5 3.5c.7 3.9 2.3 5.5 6.2 6.2-3.9.7-5.5 2.3-6.2 6.2-.7-3.9-2.3-5.5-6.2-6.2 3.9-.7 5.5-2.3 6.2-6.2Z" />
      <path d="M18.25 16c.3 1.5.9 2.1 2.4 2.4-1.5.3-2.1.9-2.4 2.4-.3-1.5-.9-2.1-2.4-2.4 1.5-.3 2.1-.9 2.4-2.4Z" />
    </svg>
  )
}
{
  name === 'play' && (
    <svg {...common} class={className} aria-hidden="true">
      <circle cx="12" cy="12" r="8.25" />
      <path d="M10 8.75 15.25 12 10 15.25V8.75Z" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === 'chat' && (
    <svg {...common} class={className} aria-hidden="true">
      <path d="M4.5 6.75a2.25 2.25 0 0 1 2.25-2.25h10.5a2.25 2.25 0 0 1 2.25 2.25v7.5a2.25 2.25 0 0 1-2.25 2.25H10l-4 3.25v-3.25H6.75a2.25 2.25 0 0 1-2.25-2.25Z" />
    </svg>
  )
}
