---
/**
 * Slim brand bar for the sub-pages, so there's always a way back to the
 * main page. Deliberately has no call-to-action: the home page hero and the
 * sticky bottom bar already carry the ask, and a third button competing with
 * them only costs vertical space.
 *
 * The home page skips this entirely and puts the brand inside the hero.
 */
import { site } from '../data/program';
import { url } from '../lib/url';
import Icon from './Icon.astro';
---

<header class="border-b border-cream-300/70 bg-cream-100">
  <div class="mx-auto max-w-6xl px-5 py-1.5 sm:px-8">
    <a
      href={url('/')}
      class="-my-1 inline-flex items-center gap-2 rounded-lg py-2.5 font-display text-sm font-bold whitespace-nowrap text-ink-900 sm:text-base"
    >
      <span
        class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-gold-400 text-cocoa shadow-sm"
      >
        <Icon name="coin" class="h-4 w-4" />
      </span>
      <span class="leading-tight">{site.name}</span>
    </a>
  </div>
</header>
