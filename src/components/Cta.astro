---
import { url } from '../lib/url';

interface Props {
  /** Button label. Keep the verb consistent across the site. */
  label?: string;
  /**
   * Line directly under the button. Its job is to remove commitment fear —
   * the objection here is "am I signing up to pay?", not "is this quick?".
   */
  note?: string | null;
  /**
   * Second line. Sets the honest expectation: registering is an expression of
   * interest, not a purchase and not a reserved place.
   */
  subnote?: string | null;
  size?: 'md' | 'lg';
  class?: string;
}

const {
  label = 'Register your child',
  note = 'Free · No payment, no obligation',
  subnote =
    'This doesn’t guarantee a spot — I’ll contact you personally to confirm.',
  size = 'lg',
  class: className = '',
} = Astro.props;

const sizes = {
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};
---

<div class={`flex flex-col items-center gap-3 ${className}`}>
  <a
    href={url('/register')}
    class={`inline-block rounded-full bg-flame-500 font-bold text-white shadow-lg shadow-flame-500/25 transition hover:-translate-y-0.5 hover:bg-flame-600 hover:shadow-xl hover:shadow-flame-500/30 active:translate-y-0 ${sizes[size]}`}
  >
    {label} →
  </a>

  {
    (note || subnote) && (
      <div class="max-w-xs text-center sm:max-w-sm">
        {note && <p class="text-sm font-semibold text-ink-700">{note}</p>}
        {subnote && (
          <p class="mt-1 text-sm leading-snug text-ink-500">{subnote}</p>
        )}
      </div>
    )
  }
</div>
